{
  "name": "desktop-companion-spike",
  "productName": "Desktop Companion",
  "version": "0.1.0",
  "private": true,
  "description": "M0 technical spike: a transparent, click-through desktop companion that walks, reacts, and runs a hydration reminder.",
  "author": "Satish",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "make-clip": "node tools/make-clip.js",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.satish.desktopcompanion",
    "productName": "Desktop Companion",
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "renderer/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "DesktopCompanion-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "DesktopCompanion-${version}-setup.exe",
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "ffmpeg-static@5.3.0": true
  },
  "dependencies": {
    "koffi": "^3.3.2"
  }
}
